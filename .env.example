# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# Database Connection (Default is SQLite, can be swapped to PostgreSQL)
# DATABASE_URL=sqlite+aiosqlite:///data/hotels.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hotel_scraper

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=2

# Proxies (Optional comma-separated URLs or leave empty)
PROXIES_ENABLED=false
PROXIES_LIST=

# Pluggable Provider: Google Places API (New) key if used
GOOGLE_PLACES_API_KEY=
